{
  "name": "QuranRecitationApp",
  "version": "2.0.0",
  "description": "Advanced Quran Recitation App with AI recognition and offline capabilities",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle",
    "clean": "react-native clean-project-auto",
    "postinstall": "cd ios && pod install"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    
    "comment_navigation": "// ===== NAVIGATION =====",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-gesture-handler": "^2.14.0",
    
    "comment_audio": "// ===== AUDIO & MEDIA =====",
    "react-native-track-player": "^4.0.1",
    "react-native-sound": "^0.11.2",
    "react-native-audio-recorder-player": "^3.6.6",
    
    "comment_voice": "// ===== VOICE RECOGNITION =====",
    "@react-native-voice/voice": "^3.2.4",
    "react-native-speech-to-text": "^2.1.0",
    
    "comment_storage": "// ===== STORAGE & OFFLINE =====",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "react-native-fs": "^2.20.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-mmkv": "^2.10.2",
    
    "comment_network": "// ===== NETWORKING =====",
    "@react-native-netinfo/netinfo": "^11.1.0",
    "react-native-background-fetch": "^4.1.8",
    "react-native-background-job": "^1.1.5",
    
    "comment_notifications": "// ===== NOTIFICATIONS =====",
    "react-native-push-notification": "^8.1.1",
    "@react-native-firebase/messaging": "^18.6.1",
    "@react-native-firebase/app": "^18.6.1",
    "react-native-local-push-notification": "^1.3.0",
    
    "comment_permissions": "// ===== PERMISSIONS =====",
    "react-native-permissions": "^4.0.4",
    
    "comment_animations": "// ===== ANIMATIONS & UI =====",
    "react-native-reanimated": "^3.6.0",
    "lottie-react-native": "^6.4.1",
    "react-native-animatable": "^1.3.3",
    "react-native-linear-gradient": "^2.8.3",
    "@react-native-community/slider": "^4.4.3",
    
    "comment_components": "// ===== UI COMPONENTS =====",
    "react-native-vector-icons": "^10.0.2",
    "react-native-modal": "^13.0.1",
    "react-native-super-grid": "^4.3.2",
    "react-native-paper": "^5.11.3",
    
    "comment_location": "// ===== LOCATION SERVICES =====",
    "@react-native-community/geolocation": "^3.2.1",
    "react-native-location": "^2.5.0",
    
    "comment_sensors": "// ===== DEVICE SENSORS =====",
    "react-native-orientation-locker": "^1.6.0",
    "react-native-device-info": "^10.11.0",
    "react-native-haptic-feedback": "^2.2.0",
    
    "comment_arabic_fonts": "// ===== ARABIC TEXT SUPPORT =====",
    "react-native-arabic-text": "^1.1.2",
    "react-native-rtl-text": "^1.0.0",
    
    "comment_utilities": "// ===== UTILITIES =====",
    "moment": "^2.29.4",
    "moment-hijri": "^2.1.2",
    "lodash": "^4.17.21",
    "react-native-uuid": "^2.0.2",
    
    "comment_testing": "// ===== DEVELOPMENT =====",
    "flipper-plugin-react-native-performance": "^0.4.0",
    "react-native-flipper": "^0.212.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/runtime": "^7.23.5",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-vector-icons|react-native-reanimated|react-native-gesture-handler|react-native-track-player|@react-native-voice)/)"
    ]
  },
  "react-native": {
    "zlib": "react-native-level-fs",
    "console": "react-native-console-time-polyfill",
    "process": "react-native-process"
  },
  "rnpm": {
    "assets": [
      "./assets/fonts/",
      "./assets/audio/",
      "./assets/images/"
    ]
  },
  "keywords": [
    "quran",
    "recitation",
    "islamic",
    "mobile-app",
    "react-native",
    "ai",
    "voice-recognition",
    "tajweed",
    "offline",
    "audio"
  ],
  "author": "Quran Learning Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/quran-recitation-app.git"
  },
  "homepage": "https://github.com/your-org/quran-recitation-app#readme"
}